{
  "name": "gallery",
  "version": "0.0.0",
  "private": true,
  "workspaces": ["apps/*"],
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "user:role": "npm run user:role --workspace=backend --",
    "test:database": "npm run test:database --workspace=backend",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "migration:generate": "npm run migration:generate --workspace=backend --",
    "migration:run": "npm run migration:run --workspace=backend",
    "migration:revert": "npm run migration:revert --workspace=backend",
    "migration:show": "npm run migration:show --workspace=backend",
    "start:backend": "npm run start:dev --workspace=backend",
    "start:frontend": "npm start --workspace=frontend",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace=backend && npm run test --workspace=frontend -- --watch=false",
    "test:e2e": "npm run test:e2e --workspace=backend",
    "lint": "npm run lint --workspace=backend"
  }
}
