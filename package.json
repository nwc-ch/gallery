{
  "name": "gallery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "build:web": "ng build",
    "start": "node dist/api/main.js",
    "dev": "concurrently -k -n api,web,oidc \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:oidc\"",
    "dev:api": "npm run build:api && node --env-file-if-exists=.env dist/api/main.js",
    "dev:web": "ng serve --host 127.0.0.1",
    "dev:oidc": "node scripts/oidc.mjs",
    "db:up": "docker compose up -d --wait",
    "test:unit": "npm run build:api && node --test dist/api/**/*.spec.js",
    "test:integration": "npm run build:api && node --env-file-if-exists=.env --test --test-concurrency=1 dist/api/tests/*.integration.js",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && ng build --configuration development",
    "api:generate": "npm run build:api && node --env-file-if-exists=.env dist/api/openapi.js && openapi-typescript docs/api/openapi.json -o packages/api-client/schema.d.ts",
    "audit:deps": "npm audit --audit-level=high"
  }
}
