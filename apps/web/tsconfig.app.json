{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/web-ts",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "types": [],
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true
  },
  "include": [
    "src/**/*.ts",
    "../../packages/api-client/**/*.ts"
  ]
}
