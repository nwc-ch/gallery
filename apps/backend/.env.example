APP_URL=http://localhost:4200
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Erzeugen mit: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Nur hinter genau einem vertrauenswürdigen Reverse Proxy aktivieren:
TRUST_PROXY=0

# Lokal passend zu docker-compose.yaml (Port 3306 ist oft bereits belegt).
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=gallery
DB_USERNAME=gallery
DB_PASSWORD=gallery_local
